WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
TRANSCRIBE_MAX_CONCURRENT=1
TRANSCRIBE_MAX_QUEUE=2
MAX_UPLOAD_SIZE_MB=500
TRANSCRIBE_MAX_DURATION_SECONDS=7200
TRANSCRIBE_TIMEOUT_SECONDS=3500
FFMPEG_TIMEOUT_SECONDS=300
# Optional: existing converted faster-whisper model directory for offline startup.
# WHISPER_MODEL_DIR=/opt/argo-models/faster-whisper-large-v3-turbo
# WHISPER_DOWNLOAD_ROOT=/opt/argo-models
# TRANSCRIBE_TEMP_DIR=/tmp/argo-transcribe
